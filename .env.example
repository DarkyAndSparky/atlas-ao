# Скопируйте этот файл в .env и заполните перед `docker compose up -d --build`.
# .env уже в .gitignore — не коммитьте его с реальными секретами.

# --- обязательные (для docker-compose.yml, публикация) ---

# Секрет для подписи cookie сессий. Сгенерировать: openssl rand -hex 48
SESSION_SECRET=

# --- HTTPS ---
#
# HTTPS-сертификат сервер терминирует сам (см. server/certs.js), без Caddy:
# - docker-compose.local.yml / start.sh / start.bat — самоподписанный,
#   генерируется автоматически, эти переменные ниже просто задают порты.
# - docker-compose.yml (публикация) — читает ГОТОВЫЙ сертификат из
#   ATLAS_CERT_FILE/ATLAS_KEY_FILE, который на хосте выпускает и продлевает
#   certbot. Порядок действий — в README ("Публикация с настоящим HTTPS").

# Порты HTTPS и HTTP-редиректа. Для docker-compose.local.yml/start.sh/start.bat
# можно менять свободно. Для docker-compose.yml (публикация) не трогайте —
# там 80/443 наружу зашиты в самом файле (нужны certbot'у), эти переменные
# там управляют только тем, что происходит ВНУТРИ контейнера.
ATLAS_HTTPS_PORT=9311
ATLAS_HTTP_REDIRECT_PORT=9312

# Где на хосте лежат fullchain.pem/privkey.pem, которые выпустил certbot —
# монтируются в контейнер как /certs (см. docker-compose.yml). Нужно только
# для публикации с настоящим доменом.
ATLAS_CERTS_HOST_DIR=./certs

# Webroot certbot'а для HTTP-01-проверки/продления сертификата — нужно
# только для публикации с настоящим доменом.
ATLAS_ACME_WEBROOT_HOST_DIR=./acme-webroot

# --- опциональные ---

# Автоматические бэкапы по расписанию (см. server/backupScheduler.js).
# По умолчанию выключено — включайте явно, когда сайт наполнен реальными данными.
# ATLAS_AUTO_BACKUP=1
# ATLAS_AUTO_BACKUP_HOUR=3
# ATLAS_AUTO_BACKUP_KEEP=14
