# Скопируйте этот файл в .env и заполните перед `docker compose up -d --build`.
# .env уже в .gitignore — не коммитьте его с реальными секретами.

# --- обязательные ---

# Секрет для подписи cookie сессий. Сгенерировать: openssl rand -hex 48
SESSION_SECRET=

# Домен, на который смотрит DNS этого сервера — Caddy сам выпустит для него
# сертификат Let's Encrypt при первом запуске (нужны открытые порты 80/443 наружу).
# Для локальной проверки без реального домена используйте, например, atlas.localhost —
# Caddy тогда выпустит локальный самоподписанный сертификат вместо Let's Encrypt.
ATLAS_DOMAIN=atlas.example.com

# --- опциональные ---

# E-mail для уведомлений Let's Encrypt об истечении/проблемах сертификата
ATLAS_ACME_EMAIL=you@example.com

# Только для docker-compose.local-https.yml (локальный HTTPS на
# самоподписанном сертификате, без домена и без Let's Encrypt) —
# на каком порту слушать HTTPS и с какого порта редиректить на него HTTP.
# На основной docker-compose.yml (публикация с Let's Encrypt) не влияют —
# тот всегда на стандартных 80/443, т.к. Let's Encrypt проверяет владение
# доменом именно на них.
ATLAS_HTTPS_PORT=9311
ATLAS_HTTP_REDIRECT_PORT=9312

# Автоматические бэкапы по расписанию (см. server/backupScheduler.js).
# По умолчанию выключено — включайте явно, когда сайт наполнен реальными данными.
# ATLAS_AUTO_BACKUP=1
# ATLAS_AUTO_BACKUP_HOUR=3
# ATLAS_AUTO_BACKUP_KEEP=14
