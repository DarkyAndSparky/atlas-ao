# зависимости — ставятся через npm install
node_modules/

# локальная база и сгенерированный секрет сессии — у каждого свои
server/atlas.db
server/atlas.db-shm
server/atlas.db-wal
server/.session-secret
server/.https-cert/
certs/
acme-webroot/

# пользовательский контент — не часть исходников проекта
uploads/*
!uploads/.gitkeep
backups/*
!backups/.gitkeep

# артефакты тестов
e2e/test-results/
e2e/playwright-report/
e2e/.cache/

# системное
.DS_Store
Thumbs.db
*.log
.env
